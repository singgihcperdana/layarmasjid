# =============================================================================
# Konfigurasi Lingkungan Layar Masjid (.env)
# =============================================================================

# Konfigurasi Database MySQL
DB_HOST=localhost
DB_NAME=layarmasjid
DB_USER=root
DB_PASS=

# Kredensial Google OAuth 2.0 (Google Sign-In)
GOOGLE_CLIENT_ID=masukkan_client_id_google_di_sini
GOOGLE_CLIENT_SECRET=masukkan_client_secret_google_di_sini
GOOGLE_REDIRECT_URI=http://localhost/layarmasjid/auth/google_callback.php
