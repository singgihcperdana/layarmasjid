# Apache configuration for my.layarmasjid.com
DirectoryIndex index.php index.html
RewriteEngine On

# 1. Routing URL Display: /display/{id} -> /display/index.html?id={id}
RewriteRule ^display/([a-zA-Z0-9_-]+)/?$ display/index.html?id=$1 [L,QSA]
RewriteRule ^display/?$ display/index.html [L,QSA]

# 2. Hilangkan ekstensi .php dari URL (Clean URLs)
# Contoh: /admin/login otomatis membaca /admin/login.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 3. Redirect jika ada yang membuka path lama /admin
RewriteRule ^admin/?$ ./ [R=301,L]

# 4. Mencegah akses langsung ke file konfigurasi rahasia
<FilesMatch "^(config\.php|\.env|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>
