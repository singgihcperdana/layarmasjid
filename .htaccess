# Apache configuration for my.layarmasjid.com
DirectoryIndex index.php index.html
RewriteEngine On

# 1. Routing URL Display: /display/{id} -> display/index.php?id={id}
RewriteRule ^display/([a-zA-Z0-9_-]+)/?$ display/index.php?id=$1 [L,QSA]
RewriteRule ^display/?$ display/index.php [L,QSA]

# 2. Routing Aset Khusus Display (contoh_slide, contoh_logo, dll)
RewriteRule ^(admin/)?assets/img/contoh_([a-zA-Z0-9_-]+)/(.*)$ display/assets/img/contoh_$2/$3 [L]

# 3. Routing Uploads jika diakses dari path admin
RewriteRule ^admin/uploads/(.*)$ uploads/$1 [L]

# 4. Routing Aset Admin: /assets/... atau /admin/assets/... -> admin/assets/...
RewriteRule ^(admin/)?assets/(.*)$ admin/assets/$2 [L]

# 5. Routing Halaman Admin: /profile, /schedule, dll (baik dengan maupun tanpa prefix admin/)
RewriteRule ^(admin/)?(profile|schedule|timer|slides|running_text|password|login|logout)/?$ admin/$2.php [L,QSA]

# 4. Hilangkan ekstensi .php untuk file lain (Clean URLs)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 5. Mencegah akses langsung ke file konfigurasi rahasia
<FilesMatch "^(config\.php|\.env|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>
